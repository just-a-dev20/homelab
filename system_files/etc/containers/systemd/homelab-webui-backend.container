[Unit]
Description=Homelab WebUI Backend
# NOTE: reference generated systemd names (foo.network -> foo-network.service,
# foo.container -> foo.service), not the quadlet filenames.
After=network-online.target homelab-webui-network-network.service zfs.target docker.socket
Wants=network-online.target homelab-webui-network-network.service
Requires=docker.socket

[Container]
Image=ghcr.io/just-a-dev20/homelab-webui-backend:latest
ContainerName=homelab-webui-backend
Network=homelab-webui-network.network
PublishPort=3001:3001
Environment=PORT=3001
Environment=NODE_ENV=production
# OS update bridge: backend exposes Settings → Updates via bootc on Homelab OS
# (file bridge in /data/os-update). Plain compose setups use UPDATE_PROVIDER=standalone.
Environment=UPDATE_PROVIDER=bootc
# Pool configuration (Settings → Storage) persists in /var (writable on bootc).
Environment=POOLS_FILE=/data/pools/pools.json
Volume=/var/run/docker.sock:/var/run/docker.sock:ro
Volume=/var/lib/homelab-webui:/data
# Host drives: configure pools on ZFS datasets mounted under /mnt
# (e.g. /mnt/tank/homelab) so all app + user files live on ZFS.
Volume=/mnt:/mnt
AutoUpdate=registry
# Pull policy (quadlet key is `Pull=`, not `PullPolicy=`).
# `missing` = pull once, then boot offline from cache; updates via auto-update timer.
Pull=missing
# Use bootc's read-only bound-image store (/usr/lib/bootc/storage, seeded at
# install/upgrade from the .image files in bound-images.d) so first boot works
# with no registry access. Do NOT enable it globally in storage.conf.
GlobalArgs=--storage-opt additionalimagestore=/usr/lib/bootc/storage

[Service]
Restart=always
RestartSec=10
# First boot pulls images; allow time so systemd doesn't kill a slow pull.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target